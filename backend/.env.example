PORT=8000
NODE_ENV=development

# MongoDB connection string.
# Example: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>

# JWT settings.
# Use a long random secret in your real .env file.
JWT_SECRET=replace_with_a_long_secure_random_secret
JWT_EXPIRE=7d

# Google Gemini API key used for AI chat, summaries, flashcards, and quizzes.
GEMINI_API_KEY=your_google_gemini_api_key

# Optional upload limit in bytes. 10485760 = 10 MB.
MAX_FILE_SIZE=10485760

# Copy this file to .env and fill in the values. Never commit secrets.
PORT=8000
NODE_ENV=development

# Browser-facing URLs. The first FRONTEND_URL is used for OAuth and reset
# redirects; comma-separated values are accepted for CORS.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# MongoDB connection string.
# Example: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>

# JWT settings.
# Use a long random secret in your real .env file.
JWT_SECRET=replace_with_a_long_secure_random_secret
JWT_EXPIRE=7d

# Session and OAuth transaction cookies.
OAUTH_COOKIE_SECRET=replace_with_another_long_random_secret
AUTH_COOKIE_DAYS=7
# Use `none` in production when the Vercel frontend and Render API are on
# different sites. Local development should use `lax`.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# Google OAuth 2.0 credentials provide an additional option beside email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP settings used only for forgot/reset password email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="LearnQuick <no-reply@example.com>"

# Google Gemini API key used for AI chat, summaries, flashcards, and quizzes.
GEMINI_API_KEY=your_google_gemini_api_key

# Optional Gemini model override. The backend uses this default when omitted.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional upload limit in bytes. 10485760 = 10 MB.
MAX_FILE_SIZE=10485760
